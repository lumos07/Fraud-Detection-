{
  "seed": 42,
  "data": {
    "profile": "kaggle",
    "source": "aryan208/financial-transactions-dataset-for-fraud-detection",
    "version": 1,
    "synthetic": true
  },
  "components": {"supervised": true, "anomaly": true, "graph": true},
  "supervised": {
    "algorithm": "lightgbm",
    "params": {"learning_rate": 0.05, "n_estimators": 200, "max_depth": 5, "num_leaves": 31, "random_state": 42, "n_jobs": 4, "verbosity": -1},
    "early_stopping_rounds": 30
  },
  "anomaly": {
    "torch_threads": 1,
    "max_training_rows": 100000,
    "weights": {"isolation_forest": 0.5, "autoencoder": 0.5},
    "isolation_forest": {"n_estimators": 100, "contamination": 0.005, "random_state": 42},
    "autoencoder": {"backend": "torch", "latent_dim": 8, "hidden_dims": [32, 16, 8], "epochs": 10, "batch_size": 2048, "learning_rate": 0.001}
  },
  "graph": {
    "community_algorithm": "leiden",
    "community_iterations": 2,
    "log_progress": true,
    "snapshot_frequency": "30D",
    "history_window": "90D",
    "label_maturity": "7D",
    "shared_attributes": ["device_id", "location", "merchant_category"],
    "attribute_weight": 1.0,
    "risk_weights": {"community": 0.4, "interaction": 0.4, "pagerank": 0.2},
    "exposure_scale": 1.0,
    "pagerank_scale": 1.0,
    "tune_weights": true,
    "weight_grid_divisions": 2,
    "seed": 42
  },
  "risk": {
    "weights": {"supervised": 0.5, "anomaly": 0.2, "graph": 0.3},
    "tune_weights": true,
    "weight_grid_step": 0.5,
    "max_review_rate": 0.1,
    "fn_cost_mode": "constant",
    "amount_loss_multiplier": 1.0,
    "initial_thresholds": {"low": 0.2, "high": 0.7},
    "threshold_grid": {"low_points": 21, "high_points": 21},
    "costs": {"c_fn": 604000.0, "c_fp": 75.0, "c_review": 8.0, "review_catch_rate": 0.7}
  }
}
